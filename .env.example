# Local development only. No cloud services, no vendor keys.
DVANTORA_DATABASE_URL=postgresql://postgres@localhost:5432/dvantora
DVANTORA_ENV=local

# ADR-0005 — run-level freshness window
DVANTORA_FRESHNESS_WINDOW_HOURS=168

# 07-data-sources.md §8 — per-run ceiling, in cents
DVANTORA_RUN_BUDGET_CENTS=75

# Only "fixture" is implemented. Real vendors require approval (07 §12).
DVANTORA_COLLECTOR_MODE=fixture

# ADR-0004 — only the non-model template provider is implemented.
DVANTORA_AI_PROVIDER=template

# 02-data-model.md §3.5 — applies to the combined (service, location) confidence.
# Below this the API returns 409 market_ambiguous with a shortlist.
DVANTORA_RESOLUTION_MIN_CONFIDENCE=0.75
DVANTORA_RESOLUTION_AMBIGUITY_MARGIN=0.15
# Below this the input is not in the taxonomy at all -> 422 service/location_unknown.
DVANTORA_RESOLUTION_UNKNOWN_FLOOR=0.60

# 02-data-model.md §3.6 — stuck-run lease before the reaper requeues
DVANTORA_RUN_LEASE_SECONDS=900

# 05-api-contract.md §1.1 — dev-only stub principal
DVANTORA_DEV_ACCOUNT_EMAIL=founder@dvantora.local
